# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000

# MongoDB Atlas connection string, including the database name (zamcloth) before the "?"
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/zamcloth?retryWrites=true&w=majority
MONGO_URI=

# Admin login. The server saves this to the database on start; change the values and restart to rotate.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Long random string (32+ characters) used to sign login sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
